-- Plantilla: NO se ejecuta automáticamente (extensión .sql.example).
--
-- 1) Crea la cuenta del profesional desde el Dashboard de Supabase:
--    Authentication → Users → Add user → introduce email + contraseña.
-- 2) Copia el "User UID" que te muestra y pégalo aquí abajo.
-- 3) Ejecuta este bloque (ya renombrado a .sql, o pegado directamente)
--    en el SQL Editor de Supabase para darle rol de profesional.

insert into public.ethobox_profiles (id, role, full_name)
values ('PEGA-AQUI-EL-USER-UID', 'professional', 'Tu nombre')
on conflict (id) do update set role = 'professional';
